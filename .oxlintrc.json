{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["/node_modules/", "/dist/", "/coverage/", "/src/data.ts"],
  "overrides": [
    {
      "files": ["tests/package-types/*"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
